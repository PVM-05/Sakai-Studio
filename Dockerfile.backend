FROM python:3.12-slim

# Cai dat cac goi he thong can thiet: FFmpeg va thu vien xu ly anh
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libgl1 \
    libglib2.0-0 \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Cai dat thu vien Python
COPY requirements-docker.txt /app/
RUN pip install --no-cache-dir -r requirements-docker.txt

# Sao chep ma nguon backend
COPY src/ /app/src/

# Tao thu muc luu tru du lieu
RUN mkdir -p /app/src/web_api/downloads /app/src/web_api/uploads /app/src/web_api/results

# Sao chep tep cookies neu co
COPY *cookies*.txt /app/ 2>/dev/null || true

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

EXPOSE 8000

CMD ["uvicorn", "src.web_api.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
